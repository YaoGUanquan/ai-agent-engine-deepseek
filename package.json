{
  "name": "ai-agent-engine-deepseek",
  "version": "0.2.0",
  "description": "Engineering teams and conversation management for DeepSeek Harness.",
  "type": "module",
  "license": "GPL-2.0-only",
  "repository": "github:YaoGUanquan/ai-agent-engine-deepseek",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./engineering": { "types": "./lib/engineering.d.ts", "default": "./lib/engineering.js" },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "skills/",
    "prompts/",
    "cordis.patch.yml",
    "compat/harness/VALIDATION.md",
    "compat/harness/LICENSE.upstream",
    "licenses/",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "engines": { "node": ">=24", "dsh": "0.2.1-rc.3" },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": []
    }
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "tsc --noEmit -p tsconfig.host.json && tsc --noEmit -p tsconfig.client.json && node tools/validate.mjs",
    "test": "vitest run",
    "check:all": "npm run check && npm test && npm run build",
    "test:stock": "node tools/harness-integration.mjs .harness/stock"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-include": "~1.0.10",
    "@deepseek-ai/dsh-agent-preset": "0.2.1-rc.3",
    "@deepseek-ai/dsh-experimental-agent-team": "0.2.1-rc.3",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "0.2.1-rc.3",
    "@deepseek-ai/dsh-experimental-tool-agent-team": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "~3.18.5",
    "js-yaml": "^4.3.0",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-remote-access": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.3",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.3",
    "@testing-library/react": "^16.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.25.0",
    "immer": "^10.1.1",
    "jsdom": "^26.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "zustand": "~4.5.7"
  }
}
