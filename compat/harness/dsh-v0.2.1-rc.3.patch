index 0000000..aa3d958
--- /dev/null
+++ b/packages/api/session-controller/src/deletion.ts
@@ -0,0 +1,132 @@
+/** Owner-only deletion of an exact, quiescent Session tree. */
+import { createHash } from 'node:crypto'
+import type { Context } from '@deepseek-ai/cordis'
+import type { SessionHeader, SessionId } from '@deepseek-ai/dsh-session'
+import type {} from '@deepseek-ai/dsh-session-projection-cache'
+import { RemoteError } from '@deepseek-ai/dsh-typert-protocol'
+import type {} from '@deepseek-ai/dsh-api-remote-access'
+import type {} from '@deepseek-ai/dsh-workspace'
+import type { SessionDeletionPreview, SessionDeletionRequest } from './types.ts'
+
+function reject(reason: string, code: 'session/delete-rejected' | 'session/delete-unsupported' | 'session/delete-scope-changed' = 'session/delete-rejected'): never {
+  throw new RemoteError(code, reason, { reason })
+}
+
+/** One Host-owned coordinator; the transport supplies its invocation Context. */
+export class SessionDeletion {
+  private readonly previews = new Map<SessionId, { preview: SessionDeletionPreview; headers: readonly SessionHeader[] }>()
+  private readonly executing = new Set<SessionId>()
+
+  constructor(private readonly timeoutMs: number) {}
+
+  private authorize(ctx: Context, ids: readonly SessionId[]): void {
+    if (ctx.invocation?.peer.principal.kind !== 'owner') reject('Only the Host owner can permanently delete conversations')
+    for (const id of ids) {
+      if (!ctx.remoteAccess.allows({ kind: 'session', id })) reject('Conversation access denied')
+    }
+  }
+
+  private async collect(ctx: Context, sessionId: SessionId): Promise<SessionHeader[]> {
+    const persistence = ctx.get('sessionPersistence')
+    if (persistence?.deletionSupported !== true) reject('This Host does not support permanent conversation deletion', 'session/delete-unsupported')
+    const headers = new Map((await persistence.list()).map(row => [row.header.id, row.header]))
+    for (const session of ctx.sessions.list()) headers.set(session.id, session.header)
+    const root = headers.get(sessionId)
+    if (root === undefined) reject('Conversation no longer exists')
+    if (root.origin === 'subagent') reject('Delete a teammate through its owning conversation')
+    const selected = new Set<SessionId>([sessionId])
+    let previous: number
+    do {
+      previous = selected.size
+      for (const header of headers.values()) {
+        if (header.origin === 'subagent' && header.parentSession !== undefined && selected.has(header.parentSession)) {
+          selected.add(header.id)
+        }
+      }
+    } while (selected.size !== previous)
+    return [...selected].sort().map(id => headers.get(id)!)
+  }
+
+  private fingerprint(headers: readonly SessionHeader[]): string {
+    return createHash('sha256').update(JSON.stringify(headers.map(header => [
+      header.id, header.createdAt, header.cwd, header.parentSession, header.origin,
+    ]))).digest('hex')
+  }
+
+  /** Inspect the selected tree without starting or stopping an Agent. */
+  async preview(ctx: Context, sessionId: SessionId): Promise<SessionDeletionPreview> {
+    this.authorize(ctx, [sessionId])
+    const headers = await this.collect(ctx, sessionId)
+    const sessionIds = headers.map(header => header.id)
+    this.authorize(ctx, sessionIds)
+    const preview: SessionDeletionPreview = {
+      sessionId, sessionIds, fingerprint: this.fingerprint(headers),
+      runningSessionIds: sessionIds.filter(id => ctx.agents.get(id)?.status === 'running'),
+    }
+    this.previews.set(sessionId, { preview, headers })
+    return preview
+  }
+
+  /** Stop, revalidate, commit deletion, and remove derived records before reporting success. */
+  async execute(ctx: Context, request: SessionDeletionRequest): Promise<readonly SessionId[]> {
+    this.authorize(ctx, request.sessionIds)
+    const persistence = ctx.get('sessionPersistence')
+    if (persistence?.deletionSupported !== true) reject('This Host does not support permanent conversation deletion', 'session/delete-unsupported')
+    if (request.stopRunning !== true) reject('Explicit stop-and-delete confirmation is required')
+    const saved = this.previews.get(request.sessionId)
+    if (saved === undefined || saved.preview.fingerprint !== request.fingerprint
+      || JSON.stringify(saved.preview.sessionIds) !== JSON.stringify(request.sessionIds)) {
+      reject('Conversation scope changed; preview and confirm deletion again', 'session/delete-scope-changed')
+    }
+    if (this.executing.has(request.sessionId)) reject('Conversation deletion is already in progress')
+    this.executing.add(request.sessionId)
+    let release: (() => void) | undefined
+    let stopping: Promise<void> | undefined
+    try {
+      const deleted = new Set(await persistence.deletedSessionIds())
+      const committed = request.sessionIds.every(id => deleted.has(id))
+      if (!committed) {
+        const headers = await this.collect(ctx, request.sessionId)
+        if (this.fingerprint(headers) !== request.fingerprint) reject('Conversation scope changed; preview and confirm deletion again', 'session/delete-scope-changed')
+      }
+      release = ctx.sessions.reserveDeletion(request.sessionIds)
+      if (!committed && this.fingerprint(await this.collect(ctx, request.sessionId)) !== request.fingerprint) {
+        reject('Conversation scope changed; preview and confirm deletion again', 'session/delete-scope-changed')
+      }
+      stopping = (async () => {
+        for (const id of request.sessionIds) ctx.agents.get(id)?.cancel({ kind: 'user' }, { keepInbox: false })
+        for (const id of request.sessionIds) await ctx.parallel('workspace/session-stop', { sessionId: id })
+        const disposed = await Promise.allSettled(request.sessionIds.map(id => ctx.agents.disposeForDeletion(id)))
+        const failed = disposed.find(result => result.status === 'rejected')
+        if (failed?.status === 'rejected') throw failed.reason
+        for (const id of request.sessionIds) {
+          const activity = await ctx.waterfall('workspace/session-activity', { sessionId: id }, () => Promise.resolve([]))
+          if (activity.length || ctx.sessions.get(id) !== undefined) reject('Conversation activity has not stopped')
+        }
+      })()
+      let timer: ReturnType<typeof setTimeout> | undefined
+      try {
+        await Promise.race([stopping, new Promise<never>((_resolve, fail) => {
+          timer = setTimeout(() => fail(new Error('Stopping conversation activity timed out')), this.timeoutMs)
+        })])
+      } finally {
+        if (timer !== undefined) clearTimeout(timer)
+      }
+      await persistence.deleteSessions(saved.headers)
+      await ctx.get('sessionProjectionCache')?.forgetSessions(request.sessionIds)
+      await ctx.workspaceRegistry.forgetSessions(request.sessionIds)
+      await ctx.sessionQuery.reconcileDeletedSessions(request.sessionIds)
+      for (const id of request.sessionIds) ctx.emit('api-session/removed', id)
+      return request.sessionIds
+    } finally {
+      const finish = (): void => {
+        release?.()
+        this.executing.delete(request.sessionId)
+      }
+      // A timeout returns to the caller but does not grant another lifecycle
+      // permission to reuse these identities while teardown is still running.
+      if (stopping) void stopping.then(finish, finish)
+      else finish()
+    }
+  }
+}
