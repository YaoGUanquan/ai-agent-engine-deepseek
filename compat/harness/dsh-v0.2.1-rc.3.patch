+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { SessionId, SESSION_FORMAT_VERSION, type SessionHeader } from '@deepseek-ai/dsh-session'
+import { SessionDeletion } from '../src/deletion.ts'
+
+const contexts: Context[] = []
+afterEach(async () => {
+  for (const ctx of contexts.splice(0)) await ctx.fiber.dispose()
+})
+function header(id: string, parent?: string, owned = false): SessionHeader {
+  return {
+    id: SessionId(id), createdAt: 1, version: SESSION_FORMAT_VERSION, isSeeded: false,
+    ...(parent ? { parentSession: SessionId(parent) } : {}),
+    ...(owned ? { origin: 'subagent' as const } : {}),
+  }
+}
+function setup(options: { owner?: boolean; denied?: string; supported?: boolean } = {}) {
+  const ctx = new Context()
+  contexts.push(ctx)
+  const headers = [header('root'), header('child', 'root', true), header('fork', 'root')]
+  const deleted = new Set<SessionId>()
+  const busy = new Set<SessionId>()
+  const reserved = new Set<SessionId>()
+  // These are unit-test ports. Real storage and Loader/browser composition
+  // are exercised separately; none of these stubs establish integration.
+  const remove = vi.fn(async (targets: readonly SessionHeader[]) => {
+    for (const target of targets) deleted.add(target.id)
+  })
+  const dispose = vi.fn(async (id: SessionId) => { busy.delete(id) })
+  const forget = vi.fn(async () => {})
+  if (options.owner !== false) ctx.provide('invocation', { peer: { principal: { kind: 'owner' } } } as never)
+  ctx.provide('remoteAccess', { allows: ({ id }: { id: string }) => id !== options.denied } as never)
+  ctx.provide('sessionPersistence', {
+    deletionSupported: options.supported ?? true,
+    list: async () => headers.filter(item => !deleted.has(item.id)).map(item => ({ header: item })),
+    deletedSessionIds: async () => [...deleted], deleteSessions: remove,
+  } as never)
+  ctx.provide('sessions', {
+    list: () => [],
+    get: () => undefined,
+    reserveDeletion: (ids: readonly SessionId[]) => {
+      for (const id of ids) reserved.add(id)
+      return () => reserved.clear()
+    },
+  } as never)
+  ctx.provide('agents', {
+    get: (id: SessionId) => busy.has(id) ? { status: 'running', cancel: vi.fn() } : undefined,
+    disposeForDeletion: dispose,
+  } as never)
+  ctx.provide('workspaceRegistry', { forgetSessions: forget } as never)
+  ctx.provide('sessionQuery', { reconcileDeletedSessions: vi.fn(async () => {}) } as never)
+  return { ctx, headers, deleted, busy, reserved, remove, dispose, forget, deletion: new SessionDeletion(1000) }
+}
+describe('owner conversation deletion', () => {
+  it('previews owned descendants and excludes independent forks without mutating data', async () => {
+    const fixture = setup()
+    fixture.busy.add(SessionId('child'))
+    const preview = await fixture.deletion.preview(fixture.ctx, SessionId('root'))
+    expect(preview.sessionIds).toEqual(['child', 'root'])
+    expect(preview.runningSessionIds).toEqual(['child'])
+    expect(fixture.remove).not.toHaveBeenCalled()
+    expect(fixture.dispose).not.toHaveBeenCalled()
+  })
+
+  it('refuses a forged scope and changed family before stopping or deleting', async () => {
+    const fixture = setup()
+    const preview = await fixture.deletion.preview(fixture.ctx, SessionId('root'))
+    await expect(fixture.deletion.execute(fixture.ctx, {
+      ...preview, sessionIds: [SessionId('root')], stopRunning: true,
+    })).rejects.toThrow('scope changed')
+    fixture.headers.push(header('late-child', 'root', true))
+    await expect(fixture.deletion.execute(fixture.ctx, { ...preview, stopRunning: true })).rejects.toThrow('scope changed')
+    expect(fixture.remove).not.toHaveBeenCalled()
+    expect(fixture.dispose).not.toHaveBeenCalled()
+  })
+
+  it('reports an unsupported persistence provider explicitly', async () => {
+    const fixture = setup({ supported: false })
+    await expect(fixture.deletion.preview(fixture.ctx, SessionId('root')))
+      .rejects.toMatchObject({ code: 'session/delete-unsupported' })
+    expect(fixture.dispose).not.toHaveBeenCalled()
+  })
+
+  it('stops the selected family and clears references before returning, including duplicate retries', async () => {
+    const fixture = setup()
+    fixture.busy.add(SessionId('root'))
+    const preview = await fixture.deletion.preview(fixture.ctx, SessionId('root'))
+    const request = { ...preview, stopRunning: true as const }
+    expect(await fixture.deletion.execute(fixture.ctx, request)).toEqual(preview.sessionIds)
+    expect(fixture.busy.size).toBe(0)
+    expect(fixture.reserved.size).toBe(0)
+    expect(fixture.forget).toHaveBeenCalledWith(preview.sessionIds)
+    expect(fixture.deleted.has(SessionId('fork'))).toBe(false)
+    expect(await fixture.deletion.execute(fixture.ctx, request)).toEqual(preview.sessionIds)
+  })
+
+  it('does not remove files when Agent teardown fails', async () => {
+    const fixture = setup()
+    const preview = await fixture.deletion.preview(fixture.ctx, SessionId('root'))
+    fixture.dispose.mockRejectedValueOnce(new Error('stop failed'))
+    await expect(fixture.deletion.execute(fixture.ctx, { ...preview, stopRunning: true })).rejects.toThrow('stop failed')
+    expect(fixture.remove).not.toHaveBeenCalled()
+    expect(fixture.reserved.size).toBe(0)
+  })
+
+  it('keeps timed-out identities reserved until the exact teardown settles and rejects duplicate submissions', async () => {
+    const fixture = setup()
+    const deletion = new SessionDeletion(10)
+    const stopped = Promise.withResolvers<void>()
+    fixture.dispose.mockImplementation(() => stopped.promise)
+    const preview = await deletion.preview(fixture.ctx, SessionId('root'))
+    const request = { ...preview, stopRunning: true as const }
+    const execution = deletion.execute(fixture.ctx, request)
+    await expect(execution).rejects.toThrow('timed out')
+    expect(fixture.reserved.size).toBe(2)
+    expect(fixture.remove).not.toHaveBeenCalled()
+    await expect(deletion.execute(fixture.ctx, request)).rejects.toThrow('already in progress')
+    stopped.resolve()
+    await vi.waitFor(() => { expect(fixture.reserved.size).toBe(0) })
+    fixture.dispose.mockImplementation(async () => {})
+    expect(await deletion.execute(fixture.ctx, request)).toEqual(preview.sessionIds)
+  })
+
+  it('holds admission until all teardown promises settle after one member fails', async () => {
+    const fixture = setup()
+    const pending = Promise.withResolvers<void>()
+    fixture.dispose.mockImplementation(id => id === 'child' ? Promise.reject(new Error('stop failed')) : pending.promise)
+    const preview = await fixture.deletion.preview(fixture.ctx, SessionId('root'))
+    const execution = fixture.deletion.execute(fixture.ctx, { ...preview, stopRunning: true })
+    const rejected = expect(execution).rejects.toThrow('stop failed')
+    await vi.waitFor(() => { expect(fixture.dispose).toHaveBeenCalledTimes(2) })
+    expect(fixture.reserved.size).toBe(2)
+    expect(fixture.remove).not.toHaveBeenCalled()
+    pending.resolve()
+    await rejected
+    expect(fixture.reserved.size).toBe(0)
+  })
+
+  it('retries partially committed cleanup with the same confirmed scope', async () => {
+    const fixture = setup()
+    const preview = await fixture.deletion.preview(fixture.ctx, SessionId('root'))
+    fixture.remove.mockImplementationOnce(async (targets) => {
+      for (const target of targets) fixture.deleted.add(target.id)
+      throw new Error('cleanup pending')
+    })
+    const request = { ...preview, stopRunning: true as const }
+    await expect(fixture.deletion.execute(fixture.ctx, request)).rejects.toThrow('cleanup pending')
+    expect(await fixture.deletion.execute(fixture.ctx, request)).toEqual(preview.sessionIds)
+  })
+
+  it('rejects a direct invocation without an owner principal', async () => {
+    const fixture = setup({ owner: false })
+    await expect(fixture.deletion.preview(fixture.ctx, SessionId('root'))).rejects.toThrow('Only the Host owner')
+    expect(fixture.remove).not.toHaveBeenCalled()
+  })
+
+  it('rejects denied descendant access without returning the tree', async () => {
+    const fixture = setup({ denied: 'child' })
+    await expect(fixture.deletion.preview(fixture.ctx, SessionId('root'))).rejects.toThrow('access denied')
+    expect(fixture.remove).not.toHaveBeenCalled()
+  })
+})
diff --git a/packages/session/session-persistence-jsonl/src/deletion.ts b/packages/session/session-persistence-jsonl/src/deletion.ts
new file mode 100644
index 0000000..2241708
--- /dev/null
+++ b/packages/session/session-persistence-jsonl/src/deletion.ts
@@ -0,0 +1,135 @@
+/** Writer-exclusive transcript removal with durable, content-free retry records. */
+import { mkdir, open, readFile, readdir, realpath, rename, unlink } from 'node:fs/promises'
+import { isAbsolute, join, relative, resolve, sep } from 'node:path'
+import { randomUUID } from 'node:crypto'
+import type { SessionHeader, SessionId } from '@deepseek-ai/dsh-session'
+import { SessionPersistenceNotFoundError } from '@deepseek-ai/dsh-session-persistence'
+import { SessionWriteLease, LEASE_FILENAME } from './lease.ts'
+import { sessionDir } from './format.ts'
+
+export const DELETION_LOCK_DIRECTORY = '.session-deletion-lock'
+const JOURNAL = '.session-deletions.json'
+
+interface DeletionRecord {
+  readonly id: SessionId
+  readonly directory: string
+}
+
+/** This journal retains identities and locations, never transcript text or titles. */
+export class JsonlDeletionJournal {
+  constructor(private readonly root: string) {}
+
+  async records(): Promise<readonly DeletionRecord[]> {
+    let text: string
+    try {
+      text = await readFile(join(this.root, JOURNAL), 'utf8')
+    } catch (error: unknown) {
+      if ((error as NodeJS.ErrnoException).code === 'ENOENT') return []
+      throw error
+    }
+    const value: unknown = JSON.parse(text)
+    if (!Array.isArray(value)) throw new Error('Invalid Session deletion journal')
+    return value.map((entry: unknown) => {
+      if (entry === null || typeof entry !== 'object'
+        || !('id' in entry) || typeof entry.id !== 'string' || entry.id.length === 0
+        || !('directory' in entry) || typeof entry.directory !== 'string') {
+        throw new Error('Invalid Session deletion record')
+      }
+      const directory = this.checkedPath(entry.directory)
+      return { id: entry.id as SessionId, directory: relative(this.root, directory) }
+    })
+  }
+
+  async assertReadable(id: SessionId): Promise<void> {
+    if ((await this.records()).some(record => record.id === id)) throw new SessionPersistenceNotFoundError(id)
+  }
+
+  private checkedPath(directory: string): string {
+    const target = resolve(this.root, directory)
+    if (isAbsolute(directory) || !target.startsWith(`${this.root}${sep}`)) {
+      throw new Error('Session deletion path escapes persistence root')
+    }
+    // A transcript directory has exactly project/session depth.
+    if (relative(this.root, target).split(sep).length !== 2) throw new Error('Invalid Session deletion directory')
+    return target
+  }
+
+  private async assertPhysicalDirectory(directory: string): Promise<void> {
+    const actualRoot = await realpath(this.root)
+    const actual = await realpath(directory)
+    if (!actual.startsWith(`${actualRoot}${sep}`) || actual !== directory) {
+      throw new Error('Session deletion refuses linked directories')
+    }
+  }
+
+  /** Acquire every transcript lock before committing any deletion identity. */
+  async remove(headers: readonly SessionHeader[]): Promise<void> {
+    await mkdir(this.root, { recursive: true, mode: 0o700 })
+    const journalLease = await SessionWriteLease.acquire(join(this.root, DELETION_LOCK_DIRECTORY), 'session-deletion-journal' as SessionId)
+    const leases: SessionWriteLease[] = []
+    try {
+      const records = new Map((await this.records()).map(record => [record.id, record]))
+      const targets = headers.map(header => records.get(header.id) ?? {
+        id: header.id, directory: relative(this.root, sessionDir(this.root, header.cwd, header.id)),
+      })
+      targets.sort((a, b) => a.id.localeCompare(b.id))
+      for (const record of targets) {
+        const directory = this.checkedPath(record.directory)
+        await this.assertPhysicalDirectory(directory)
+        leases.push(await SessionWriteLease.acquire(directory, record.id))
+        // Never follow a foreign directory added while lock acquisition awaited.
+        await this.assertPhysicalDirectory(directory)
+        for (const entry of await readdir(directory, { withFileTypes: true })) {
+          if (!entry.isFile()) throw new Error('Session deletion refuses unexpected directory entries')
+        }
+      }
+      for (const record of targets) records.set(record.id, record)
+      const temporary = join(this.root, `${JOURNAL}.${randomUUID()}.tmp`)
+      const file = await open(temporary, 'wx', 0o600)
+      try {
+        await file.writeFile(JSON.stringify([...records.values()]))
+        await file.sync()
+      } finally {
+        await file.close()
+      }
+      await rename(temporary, join(this.root, JOURNAL))
+      await this.syncRoot()
+      for (const record of targets) await this.clean(record)
+    } finally {
+      const failures: unknown[] = []
+      for (const lease of leases.reverse()) {
+        try { await lease.release() } catch (error: unknown) { failures.push(error) }
+      }
+      try { await journalLease.release() } catch (error: unknown) { failures.push(error) }
+      if (failures.length) throw new AggregateError(failures, 'Session deletion lock release failed')
+    }
+  }
+
+  /** Resume a committed operation after process death before serving storage. */
+  async recover(): Promise<void> {
+    for (const record of await this.records()) {
+      const directory = this.checkedPath(record.directory)
+      await this.assertPhysicalDirectory(directory)
+      const lease = await SessionWriteLease.acquire(directory, record.id)
+      try { await this.clean(record) } finally { await lease.release() }
+    }
+  }
+
+  private async clean(record: DeletionRecord): Promise<void> {
+    const directory = this.checkedPath(record.directory)
+    await this.assertPhysicalDirectory(directory)
+    for (const entry of await readdir(directory, { withFileTypes: true })) {
+      if (entry.name === LEASE_FILENAME) continue
+      if (!entry.isFile()) throw new Error('Session deletion refuses unexpected directory entries')
+      await unlink(join(directory, entry.name))
+    }
+    // Keep the stable lock inode and directory so another writer cannot lock
+    // a replacement inode while an existing descriptor is still held.
+  }
+
+  private async syncRoot(): Promise<void> {
+    if (process.platform === 'win32') return
+    const directory = await open(this.root, 'r')
+    try { await directory.sync() } finally { await directory.close() }
+  }
+}
diff --git a/packages/session/session-persistence-jsonl/tests/deletion.spec.ts b/packages/session/session-persistence-jsonl/tests/deletion.spec.ts
