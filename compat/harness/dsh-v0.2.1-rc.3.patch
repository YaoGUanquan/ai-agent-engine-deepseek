+++ b/packages/session/session-persistence-jsonl/tests/deletion.spec.ts
@@ -0,0 +1,120 @@
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { mkdir, mkdtemp, readFile, readdir, rm } from 'node:fs/promises'
+import { resolve, join } from 'node:path'
+import { SessionId, SESSION_FORMAT_VERSION, type SessionHeader } from '@deepseek-ai/dsh-session'
+import * as backend from '../src/index.ts'
+import { sessionDir } from '../src/format.ts'
+
+const fault = vi.hoisted(() => ({ unlink: false }))
+vi.mock('node:fs/promises', async (original) => {
+  const actual = await original<typeof import('node:fs/promises')>()
+  return {
+    ...actual,
+    unlink: async (path: Parameters<typeof actual.unlink>[0]) => {
+      if (fault.unlink) {
+        fault.unlink = false
+        throw new Error('injected transcript cleanup failure')
+      }
+      return actual.unlink(path)
+    },
+  }
+})
+
+const contexts: Context[] = []
+const roots: string[] = []
+async function openBackend(root?: string): Promise<Context> {
+  await mkdir(resolve('.artifacts'), { recursive: true })
+  const directory = root ?? await mkdtemp(resolve('.artifacts/ae-delete-'))
+  if (root === undefined) roots.push(directory)
+  const ctx = new Context()
+  contexts.push(ctx)
+  await ctx.plugin(backend, { root: directory, compression: 'none' })
+  return ctx
+}
+function header(id: string, parentSession?: string, child = false): SessionHeader {
+  return {
+    id: SessionId(id), version: SESSION_FORMAT_VERSION, createdAt: 1, isSeeded: false,
+    cwd: resolve('.'),
+    ...(parentSession ? { parentSession: SessionId(parentSession) } : {}),
+    ...(child ? { origin: 'subagent' as const } : {}),
+  }
+}
+async function persist(ctx: Context, meta: SessionHeader) {
+  const handle = await ctx.sessionPersistence.create(meta)
+  await handle.flush()
+  await handle.close()
+}
+afterEach(async () => {
+  fault.unlink = false
+  for (const ctx of contexts.splice(0)) await ctx.fiber.dispose()
+  for (const root of roots.splice(0)) await rm(root, { recursive: true, force: true })
+})
+
+describe('permanent Session deletion', () => {
+  it('removes only the selected transcripts, rejects resurrection, and survives restart', async () => {
+    const ctx = await openBackend()
+    const root = roots[0]!
+    const parent = header('parent')
+    const child = header('child', 'parent', true)
+    const independent = header('fork', 'parent')
+    for (const item of [parent, child, independent]) await persist(ctx, item)
+    const oldReader = await ctx.sessionPersistence.open(parent.id, 'read')
+    await ctx.sessionPersistence.deleteSessions([parent, child])
+    expect(await ctx.sessionPersistence.stat(parent.id)).toBeUndefined()
+    expect((await ctx.sessionPersistence.list()).map(row => row.header.id)).toEqual([independent.id])
+    await expect(ctx.sessionPersistence.open(parent.id, 'read')).rejects.toThrow()
+    await expect(ctx.sessionPersistence.create(parent)).rejects.toThrow()
+    await expect(oldReader.read()).rejects.toThrow()
+    await oldReader.close()
+    const entries = await readdir(sessionDir(root, parent.cwd, parent.id))
+    expect(entries.every(name => name === 'session.lock')).toBe(true)
+    await ctx.fiber.dispose()
+    const reopened = await openBackend(root)
+    expect((await reopened.sessionPersistence.list()).map(row => row.header.id)).toEqual([independent.id])
+    expect(await reopened.sessionPersistence.deletedSessionIds()).toContain(parent.id)
+  })
+
+  it('does not commit any deletion while a target writer is held', async () => {
+    const ctx = await openBackend()
+    const one = header('one')
+    const two = header('two')
+    await persist(ctx, one)
+    await persist(ctx, two)
+    const competing = await openBackend(roots[0])
+    const writer = await competing.sessionPersistence.open(two.id, 'write')
+    await expect(ctx.sessionPersistence.deleteSessions([one, two])).rejects.toThrow()
+    expect(await ctx.sessionPersistence.deletedSessionIds()).toEqual([])
+    expect(await ctx.sessionPersistence.stat(one.id)).toBeDefined()
+    expect(await ctx.sessionPersistence.stat(two.id)).toBeDefined()
+    await writer.close()
+    await ctx.sessionPersistence.deleteSessions([one, two])
+    expect(await ctx.sessionPersistence.list()).toEqual([])
+  })
+
+  it('recovers committed cleanup after a partial failure without exposing the transcript', async () => {
+    const ctx = await openBackend()
+    const meta = header('retry')
+    await persist(ctx, meta)
+    fault.unlink = true
+    await expect(ctx.sessionPersistence.deleteSessions([meta])).rejects.toThrow('injected')
+    expect(await ctx.sessionPersistence.stat(meta.id)).toBeUndefined()
+    expect(await ctx.sessionPersistence.list()).toEqual([])
+    await ctx.fiber.dispose()
+    const resumed = await openBackend(roots[0])
+    expect(await resumed.sessionPersistence.list()).toEqual([])
+    await expect(resumed.sessionPersistence.create(meta)).rejects.toThrow()
+    const bytes = await readFile(join(roots[0]!, '.session-deletions.json'), 'utf8')
+    expect(bytes).not.toContain('"title"')
+    expect(bytes).not.toContain('"content"')
+  })
+
+  it('allows repeated physical cleanup with the original confirmed identities', async () => {
+    const ctx = await openBackend()
+    const meta = header('idempotent')
+    await persist(ctx, meta)
+    await ctx.sessionPersistence.deleteSessions([meta])
+    await ctx.sessionPersistence.deleteSessions([meta])
+    expect(await ctx.sessionPersistence.deletedSessionIds()).toEqual([meta.id])
+  })
+})
